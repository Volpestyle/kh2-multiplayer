{
  // Draft extension on top of the current co-op packet model.
  // Goal: support two products under one protocol family:
  //  1) CampaignCoop  (3-player shared party/story)
  //  2) PublicRealm   (persistent characters + public hubs + party instances)

  "protocolVersion": 9,
  // V9 adds exact ordinary-record content to native resync; WorldBridge is 11.
  // The optional HARP/v1 historical-input trailer is 1128 bytes, covered by
  // snapshot SHA but excluded from the native-state fingerprint.
  // V8 scopes native world packets with immutable producer/target delivery
  // context. Resync26 is a fresh-capture transaction: binding33, envelope34,
  // plan35, begin36/part37/end38, native ACK39 and fixed-target result40.
  // Original 30-second deadline, complete full progress/population snapshot,
  // source cut and one optional checkpoint. Dead bootstrap remains unavailable.
  // WorldBridge10 has an independent bounded CAS operator mailbox; CLI queue
  // receipt is not native convergence. See docs/FORCED_RESYNC.md.
  // V7 EnemyHp: u32 epoch, u64 nonzero source sequence, u16 count, then
  // count * (u16 netId, i32 hp, i32 maxHp). Source order survives rooms and
  // manifests; relay/client reject older samples before cache/raw callbacks.
  // Equal reliable relay cache replay is allowed. See docs/HP_ORDERING.md.
  // V6 adds diagnostic request30/chunk31/done32 with strict bounded codecs.
  // All three ENet channels are negotiated: gameplay reliable0/unreliable1,
  // diagnostics reliable2. Frozen session+connection roster, report ID,
  // relay receipt witnesses, nonextending remaining lifetime and raw SHA-256
  // artifact transfers are described in docs/DESYNC_REPORTS.md.
  // CampaignCoop v5 retains the v4 byte layouts, but requires typed closure
  // reasons and an OS-random 128-bit world incarnation in SessionState.sessionId.
  // Configured session names are labels; a new Player lifetime mints a new token.
  // Automatic friend rejoin pins the original token, host peer/connection and
  // exact local peer/slot. It never migrates hosts or accepts a restarted relay.
  // ENet close codes / HelloReject: 0 unknown transport, 1 incompatible,
  // 2 admission rejected, 3 peer idle, 4 host ended, 5 relay stopping,
  // 6 handshake timeout, 7 occupied slot, 8 full lobby; unknown nonzero terminal.
  // Code 9 is a local resume-pin mismatch, never a new session admission.
  // AvatarRelay is exactly 84 payload bytes: ownerConnectionId:u64 followed
  // by the unchanged 76-byte AvatarState. Relay stamps connection and slot;
  // receivers require the current roster incarnation before sequence/loss
  // accounting or callbacks. Outbound AvatarState remains 76 bytes.
  // ClientHello only; no legacy SessionState handshake.
  // SessionActor appends uint64 connectionId after archetype. Relay assigns a
  // nonzero ID once per verified connection, never reused in its lifetime.
  // HitClaim wire order (43 bytes): epoch:u32, seq:u32, netId:u16,
  // objectId:u32, requesterConnectionId:u64, attackId:u32, damage:i32,
  // attackerPosition:float32[3], attackerSlot:u8. Claim echoes its detection
  // connection; seq strictly increases across rooms, without wrap. Relay
  // validates current manifest type, epoch and identity, then stamps the slot.

  "enums": {
    "Mode": ["CampaignCoop", "PublicRealm"],
    "InstanceType": [
      "CampaignPartyInstance",
      "PublicHubInstance",
      "AdventureInstance",
      "PvpArenaInstance"
    ],
    "AuthorityType": ["HostClient", "DedicatedWorker"],
    "NativeRole": [
      "LocalPrimary",
      "LocalCompanion1",
      "LocalCompanion2",
      "RemoteReplica",
      "RemoteEnemy",
      "RemoteNpc"
    ]
  },

  "stableIds": {
    "PeerId": "string",
    "CharacterId": "string",
    "PartyId": "string",
    "RealmId": "string",
    "InstanceId": "string",
    "ActorNetId": "uint32"
  },

  "records": {
    "ClientHello": {
      "protocolVersion": "uint16",
      "gameBuild": "string",
      "contentHash": "string",
      "modHash": "string",
      "peerName": "string",
      "requestedMode": "Mode"
    },

    "RealmSeed": {
      "realmId": "string",
      "sourceSaveChecksum": "string",
      "buildHash": "string",
      "contentHash": "string",
      "unlockedWorlds": ["uint16"],
      "unlockedWarpPoints": ["string"],
      "storyFlags": ["uint32"],
      "clearedBossFlags": ["uint32"]
    },

    "CharacterRecord": {
      "characterId": "string",
      "ownerPeerId": "string",
      "displayName": "string",
      "archetypeId": "string",
      "level": "uint16",
      "equipment": ["string"],
      "abilities": ["string"],
      "stats": {
        "hp": "int32",
        "mp": "int32",
        "drive": "int32"
      }
    },

    "PartyRecord": {
      "partyId": "string",
      "leaderCharacterId": "string",
      "memberCharacterIds": ["string"],
      "partyMode": "Mode",
      "activeInstanceId": "string|null"
    },

    "InstanceDescriptor": {
      "instanceId": "string",
      "instanceType": "InstanceType",
      "authorityType": "AuthorityType",
      "authorityPeerId": "string|null",
      "realmId": "string",
      "worldId": "uint16",
      "roomId": "uint16",
      "mapProgram": "uint16",
      "battleProgram": "uint16",
      "eventProgram": "uint16",
      "maxPlayers": "uint16",
      "pvpEnabled": "bool"
    },

    "ActorBinding": {
      "actorNetId": "uint32",
      "characterId": "string|null",
      "ownerPeerId": "string|null",
      "nativeRole": "NativeRole",
      "slotType": "uint8|null",
      "archetypeId": "string",
      "localOnly": "bool"
    }
  },

  "campaignCoop": {
    "identityModel": {
      "PeerId": "stable network identity",
      "CharacterId": "optional in v1; can be inferred from save/slot",
      "ActorNetId": "unique actor identity even when slot changes",
      "SlotType": "mapping only inside a given co-op instance"
    },
    "notes": [
      "Keep current canonical slot architecture: PLAYER, FRIEND_1, FRIEND_2.",
      "Host KH2 process is the gameplay authority.",
      "Story owner and save owner are the same host peer."
    ]
  },

  "publicRealm": {
    "notes": [
      "Local player should always map to a local-primary control path on their own client.",
      "Other humans are remote replicas, not co-op party slots by default.",
      "Rooms are instanced/sharded. Realm service is not a full battle simulator.",
      "PvP should be arena-instanced and opt-in."
    ],
    "services": {
      "RealmService": [
        "login",
        "character roster",
        "party membership",
        "instance registry",
        "realm seed metadata",
        "chat/presence"
      ],
      "InstanceAuthority": [
        "player transforms",
        "enemy state",
        "spawn events",
        "room transitions",
        "reward writeback"
      ]
    }
  },

  "newMessages": {
    "ClientHello": "client -> server",
    "ClientHelloAck": "server -> client",
    "SelectCharacterRequest": "client -> server",
    "SelectCharacterAck": "server -> client",
    "CreatePartyRequest": "client -> server",
    "InvitePartyRequest": "client -> server",
    "JoinPartyRequest": "client -> server",
    "LeavePartyRequest": "client -> server",
    "CreateInstanceRequest": "client -> server",
    "JoinInstanceRequest": "client -> server",
    "JoinInstanceAck": "server -> client",
    "InstanceState": "server -> client",
    "ActorBindings": "instance authority -> client",
    "CharacterDelta": "server <-> client",
    "RealmChat": "server <-> client",
    "PvpDuelRequest": "client -> server",
    "PvpDuelAccept": "client -> server"
  },

  "importantRefactorsNow": [
    "Stop overloading SessionState as handshake.",
    "Stop overloading sessionId as peer name.",
    "Introduce ActorNetId separate from SlotType.",
    "Split Party/Session ownership from active gameplay Instance ownership.",
    "Keep CampaignCoop and PublicRealm as explicit runtime modes."
  ]
}
