            }
          },
          "required": [
            "stdout",
            "stderr"
          ]
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stdout": {
              "$ref": "#/$defs/rawArtifact"
            },
            "stderr": {
              "$ref": "#/$defs/rawArtifact"
            }
          },
          "required": [
            "stdout",
            "stderr"
          ]
        }
      },
      "required": [
        "helper",
        "encoder",
        "verifier"
      ]
