        },
        "metricsAlgorithmSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blackFrames": {
          "const": 0,
          "type": "integer"
        },
        "nonblackDistinctFrames": {
          "type": "integer",
          "minimum": 2
        },
        "motionQualified": {
          "const": true,
          "type": "boolean"
        },
        "maximumChangedPixels": {
          "type": "integer",
          "minimum": 64
        },
        "motionChannelDelta": {
          "const": 16,
          "type": "integer"
        },
        "motionMinimumChangedPixels": {
          "const": 64,
          "type": "integer"
