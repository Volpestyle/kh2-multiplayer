          "type": "integer"
        }
      },
      "required": [
        "instance",
        "output",
        "seconds",
        "requestedFps"
      ]
    },
    "capture90": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRequestSeq": {
          "type": "integer",
          "minimum": 1
        },
        "doneSeq": {
          "type": "integer",
          "minimum": 1
        },
        "nativeStatus": {
          "const": 0,
          "type": "integer"
        },
        "framesWritten": {
          "type": "integer",
          "const": 90
        },
        "requestedInterval": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "renderer": {
          "type": "integer",
          "minimum": 1
        },
        "backbufferFormat": {
          "type": "integer",
          "minimum": 1
        },
        "gameFpsBefore": {
          "type": "number",
          "minimum": 1
        },
        "gameFpsDuringCapture": {
          "type": "number",
          "minimum": 1
        },
        "encodedFps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "startedNs": {
          "type": "integer",
          "minimum": 1
        },
        "finishedNs": {
          "type": "integer",
          "minimum": 1
        },
        "captureLeaseReleased": {
          "const": true,
          "type": "boolean"
        },
        "seconds": {
          "type": "integer",
          "const": 3
        },
        "frameCount": {
          "type": "integer",
          "const": 90
        }
      },
      "required": [
        "expectedRequestSeq",
        "doneSeq",
        "nativeStatus",
        "framesWritten",
        "requestedInterval",
        "width",
        "height",
        "renderer",
        "backbufferFormat",
        "gameFpsBefore",
        "gameFpsDuringCapture",
        "encodedFps",
        "startedNs",
        "finishedNs",
        "captureLeaseReleased",
        "seconds",
        "frameCount"
      ]
    },
    "decode90": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decodedAllFrames": {
          "const": true,
          "type": "boolean"
        },
        "decodeErrors": {
          "const": 0,
          "type": "integer"
        },
        "decodedFrames": {
          "type": "integer",
          "const": 90
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
