{
  "name": "net_enemy_sync_waves",
  "description": "VUH-1502: host + 2 clients (roles from the runtimes' session slots) in 12/0B btl 1. Host-only damage: clients' HP must match the host's; host kills must kill every client copy once through the native path; the room's second sub-wave must spawn and clear everywhere, and battle state must end everywhere.",
  "steps": [
    {
      "do": "boot",
      "instance": 0
    },
    {
      "do": "boot",
      "instance": 1
    },
    {
      "do": "boot",
      "instance": 2
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 18,
      "room": 11,
      "btl": 1
    },
    {
      "do": "warp",
      "instance": 1,
      "world": 18,
      "room": 11,
      "btl": 1
    },
    {
      "do": "warp",
      "instance": 2,
      "world": 18,
      "room": 11,
      "btl": 1
    },
    {
      "do": "protect",
      "instance": 0
    },
    {
      "do": "protect",
      "instance": 1
    },
    {
      "do": "protect",
      "instance": 2
    },
    {
      "do": "relay"
    },
    {
      "do": "runtime",
      "instance": 0,
      "role": "player"
    },
    {
      "do": "runtime",
      "instance": 1,
      "role": "friend1"
    },
    {
      "do": "runtime",
      "instance": 2,
      "role": "friend2"
    },
    {
      "do": "input",
      "instance": 0,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "input",
      "instance": 1,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "input",
      "instance": 2,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "input",
      "instance": 0,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "input",
      "instance": 1,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "input",
      "instance": 2,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "input",
      "instance": 0,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "input",
      "instance": 1,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "input",
      "instance": 2,
      "ly": 1,
      "ms": 900
    },
    {
      "do": "wait",
      "ms": 4000
    },
    {
      "do": "save",
      "as": "spawned",
      "expr": "[[(a['name'], a['address'][-5:], a.get('hp'), round(a['position']['x']), round(a['position']['z'])) for a in enemies(k)] for k in range(3)]"
    },
    {
      "do": "wait_until",
      "expr": "len(enemy_hps(0)) > 0 and len(enemy_hps(1)) == len(enemy_hps(0)) and len(enemy_hps(2)) == len(enemy_hps(0))",
      "timeoutMs": 15000,
      "pollMs": 500
    },
    {
      "do": "save",
      "as": "before",
      "expr": "[enemy_hps(i) for i in range(3)]"
    },
    {
      "do": "hit_all",
      "instance": 0,
      "op": "damage",
      "amount": 7
    },
    {
      "do": "wait",
      "ms": 400
    },
    {
      "do": "save",
      "as": "after_damage",
      "expr": "[enemy_hps(i) for i in range(3)]"
    },
    {
      "do": "assert",
      "expr": "saved['after_damage'][0] == saved['after_damage'][1] == saved['after_damage'][2] and saved['after_damage'][0] != saved['before'][0]",
      "message": "client HP doesn't match the host's after host-only damage"
    },
    {
      "do": "save",
      "as": "host_logs",
      "expr": "[log_count('[enemysync] client: matched', i) for i in range(3)]"
    },
    {
      "do": "hit_all",
      "instance": 0,
      "op": "kill"
    },
    {
      "do": "wait_until",
      "expr": "len(enemy_hps(1)) == 0 and len(enemy_hps(2)) == 0",
      "timeoutMs": 8000,
      "pollMs": 250
    },
    {
      "do": "save",
      "as": "deaths_applied",
      "expr": "[log_count('host death netId', i) for i in range(3)]"
    },
    {
      "do": "save",
      "as": "host_deaths_sent",
      "expr": "log_count('[enemysync] host death', 0)"
    },
    {
      "do": "wait",
      "ms": 6000
    },
    {
      "do": "save",
      "as": "second_wave",
      "expr": "[enemy_hps(i) for i in range(3)]"
    },
    {
      "do": "hit_all",
      "instance": 0,
      "op": "kill"
    },
    {
      "do": "wait_until",
      "expr": "all(len(enemy_hps(i)) == 0 for i in range(3))",
      "timeoutMs": 10000,
      "pollMs": 500
    },
    {
      "do": "wait",
      "ms": 4000
    },
    {
      "do": "save",
      "as": "battle_state",
      "expr": "[peek('0x2A11404', 'u8', i) for i in range(3)]"
    },
    {
      "do": "save",
      "as": "final_deaths",
      "expr": "[log_count('host death netId', i) for i in range(3)]"
    },
    {
      "do": "assert",
      "expr": "all(len(enemy_hps(i)) == 0 for i in range(3))",
      "message": "enemies left on some instance"
    },
    {
      "do": "capture",
      "name": "end",
      "instance": 1
    }
  ]
}