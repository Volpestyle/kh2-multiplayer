{
  "name": "net_enemy_target_all_soldier",
  "description": "VUH-2193: mirror-only Soldier targeting of Friend1 in BC btl2. Uses the previously qualified world-5 clone leaf and west activator point; restores the leaf before owned cleanup. PARTY_NATIVE coexistence is an offline check, because that mode does not yet qualify BC.",
  "protect": [0, 1],
  "steps": [
    {"do":"boot","instance":0,"initTimeoutMs":60000,"env":{"KH2COOP_ENEMY_TARGET_ALL":"1","KH2COOP_ENEMY_MIRROR":"1","KH2COOP_NATIVE_SORA_PRIVATE_STATUS":"1","KH2COOP_CLONE_NEUTRAL_INPUT":"1","KH2COOP_PUPPET_TRACE":"1","KH2COOP_DOWNED_SPIKE":"1"}},
    {"do":"boot","instance":1,"initTimeoutMs":60000,"env":{"KH2COOP_ENEMY_TARGET_ALL":"1","KH2COOP_ENEMY_MIRROR":"1","KH2COOP_PUPPET_TRACE":"1","KH2COOP_DOWNED_SPIKE":"1"}},
    {"do":"assert","expr":"[peek(0x9ACDF8+n, 'u8', 0) for n in range(4)] == [0,1,2,18]","message":"BC leaf differs from the qualified native row"},
    {"do":"kh2ctl","instance":0,"args":["poke","--rva","0x9ACDF9","--type","u8","--value","0"]},
    {"do":"warp","instance":0,"world":5,"room":6,"door":0,"map":1,"btl":2,"evt":0},
    {"do":"warp","instance":1,"world":5,"room":6,"door":0,"map":1,"btl":2,"evt":0},
    {"do":"relay","port":27796,"args":["--bind","127.0.0.1"]},
    {"do":"runtime","instance":0,"role":"player"},
    {"do":"runtime","instance":1,"role":"friend1"},
    {"do":"wait_until","expr":"log_count('[enemy-target] search-swap ok=1',0)>0 and log_count('[privatestatus] kind=3',0)>0","timeoutMs":12000},
    {"do":"wait_until","expr":"len(actors(0))>0 and len(actors(1))>0 and location(0)==[5,6,0,1,2,0] and location(1)==location(0)","timeoutMs":20000},
    {"do":"save","as":"before","expr":"[actors(0),actors(1)]"},
    {"do":"kh2ctl","instance":1,"argsExpr":"['poke','--addr',str(int(actors(1)[0]['address'],16)+0x670),'--type','f32x3','--value','-2790,0,-1650']"},
    {"do":"kh2ctl","instance":0,"argsExpr":"['poke','--addr',str(int(actors(0)[0]['address'],16)+0x670),'--type','f32x3','--value','-2850,0,-1650']"},
    {"do":"wait_until","expr":"any(a['name']=='M_EX010' for a in enemies(0)) and any(a['name']=='M_EX010' for a in enemies(1))","timeoutMs":12000},
    {"do":"kh2ctl","instance":0,"argsExpr":"['poke','--addr',str(int(actors(0)[0]['address'],16)+0x670),'--type','f32x3','--value','-2000,0,-1500']"},
    {"do":"wait_until","expr":"len(log_matches(r'assign .*owner=1 .*objectId=301',0))>0","timeoutMs":12000},
    {"do":"save","as":"hp_before","expr":"actors(1)[0]['hp']"},
    {"do":"protect","instance":1,"on":false},
    {"do":"kh2ctl","instance":1,"argsExpr":"['poke','--addr',str(int(actors(1)[0]['address'],16)+0x4DC),'--type','u32','--value','1']"},
    {"do":"clip","instance":1,"seconds":12,"name":"friend_soldier_attack"},
    {"do":"capture","instance":0,"name":"host_targets_friend"},
    {"do":"save","as":"after","expr":"[actors(0),actors(1)]"},
    {"do":"assert","expr":"actors(1)[0]['hp'] < saved['hp_before']","message":"Friend received no native incoming damage"},
    {"do":"assert","expr":"log_count('[enemy-target] forward ',0)==0 and log_count('[enemy-target] veto ',1)==0 and log_count('[enemy-target] remote-hit ',1)==0","message":"Mirror-only route forwarded or vetoed damage"},
    {"do":"assert","expr":"log_count('[enemy-mirror] hit ',1)>0","message":"No driven-enemy native hit was logged"},
    {"do":"kh2ctl","instance":0,"args":["poke","--rva","0x9ACDF9","--type","u8","--value","1"]},
    {"do":"assert","expr":"[peek(0x9ACDF8+n,'u8',0) for n in range(4)]==[0,1,2,18]","message":"BC leaf restore differs"}
  ]
}
