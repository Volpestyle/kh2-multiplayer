{
  "name": "net_hb1_bailey",
  "description": "VUH-2343 development probe: two local player-default instances enter the authored HB08 battle52 mission141 through a host warp (development only). Record native party/guest actors, remote puppet availability and enemy current/max HP on both sides; film native bot combat. No enemy kills, mission-result writes, guest replacement or save-folder writes are used. This first probe diagnoses the forced-solo fight; it does not certify native-door D15 travel or the mission's completion edge.",
  "playerDefaults": true,
  "steps": [
    {"do": "boot", "instance": 0, "initTimeoutMs": 60000},
    {"do": "boot", "instance": 1, "initTimeoutMs": 60000},
    {"do": "warp", "instance": 0, "world": 4, "room": 26, "evt": 0},
    {"do": "warp", "instance": 1, "world": 4, "room": 26, "evt": 0},
    {"do": "relay", "port": 27803, "args": ["--bind", "127.0.0.1"]},
    {"do": "runtime", "instance": 0, "role": "player"},
    {"do": "runtime", "instance": 1, "role": "friend1"},
    {"do": "wait_until", "expr": "all((bridge(i).get('puppet0') or {}).get('active') for i in range(2))", "timeoutMs": 30000},
    {"do": "save", "as": "goa_actors", "expr": "[actors(i) for i in range(2)]"},
    {"do": "save", "as": "notices_before", "expr": "[runtime_log(i).count('Desync notice') for i in range(2)]"},
    {"do": "warp", "instance": 0, "world": 4, "room": 10, "evt": 0},
    {"do": "transition_check", "instances": [0,1], "target": [4,10], "as": "borough_native_clone_prerequisite", "timeoutMs": 30000, "capture": true},
    {"do": "save", "as": "borough_actors", "expr": "[actors(i) for i in range(2)]"},
    {"do": "warp", "instance": 0, "world": 4, "room": 8, "door": 0, "map": 52, "btl": 52, "evt": 0},
    {"do": "wait_until", "expr": "all(location(i)==[4,8,0,52,52,0] and any(a['name']=='P_EX100' for a in actors(i)) for i in range(2))", "timeoutMs": 40000},
    {"do": "capture", "instance": 0, "name": "bailey_entry_host"},
    {"do": "capture", "instance": 1, "name": "bailey_entry_friend"},
    {"do": "save", "as": "bailey_entry", "expr": "[{'location':location(i),'actors':actors(i),'bridge':bridge(i),'partyRow':peek('0x9ACDF4','u32',i),'members':[peek('0x2A25300','u16',i),peek('0x2A25302','u16',i),peek('0x2A25304','u16',i)]} for i in range(2)]"},
    {"do": "wait_until", "expr": "len(enemy_hps(0))>0", "timeoutMs": 20000},
    {"do": "save", "as": "bailey_before", "expr": "[[(a['name'],a['objectId'],a['hp'],a['maxHp'],a['position']) for a in enemies(i)] for i in range(2)]"},
    {"do": "fight", "instances": [0,1], "seconds": 25, "as": "bailey_fight",
     "clips": [{"instance":0,"seconds":20,"fps":15,"name":"bailey_host"},
               {"instance":1,"seconds":20,"fps":15,"name":"bailey_friend"}]},
    {"do": "save", "as": "bailey_after", "expr": "[{'location':location(i),'actors':actors(i),'bridge':bridge(i)} for i in range(2)]"},
    {"do": "capture", "instance": 0, "name": "bailey_after_host"},
    {"do": "capture", "instance": 1, "name": "bailey_after_friend"},
    {"do": "save", "as": "desync_notices", "expr": "[runtime_log(i).count('Desync notice')-saved['notices_before'][i] for i in range(2)]"},
    {"do": "wait_until", "expr": "enemy_hps(0)==enemy_hps(1)", "timeoutMs": 10000},
    {"do": "transition_check", "instances": [0,1], "target": [4,8], "as": "bailey_native_arrival", "timeoutMs": 10000, "capture": true},
    {"do": "assert", "expr": "all(saved['bailey_fight'][str(i)]['presses']>0 and not saved['bailey_fight'][str(i)].get('error') for i in range(2))", "message": "Both native Soras must make positive combat input; a bot loop or clip alone is insufficient"}
  ]
}
