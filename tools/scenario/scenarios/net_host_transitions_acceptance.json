{
  "name": "net_host_transitions_acceptance",
  "description": "VUH-1496 transition route: after a late join, 20 host-requested native loads across five party-room fixtures (GoA and BC 05/01,04,05,06) with three instances. Every load must advance the completed-load epoch and restore full-location parity, relay ACKs and both native puppet slots with correct owners. Loads 19 and 20 are an identical-location reload pair. This route alone does not prove a natural scripted same-room reload, client walking-exit denial, cutscene hold, or shared-state hashes.",
  "steps": [
    {
      "do": "boot",
      "instance": 0
    },
    {
      "do": "boot",
      "instance": 1
    },
    {
      "do": "boot",
      "instance": 2
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 4,
      "room": 26
    },
    {
      "do": "warp",
      "instance": 1,
      "world": 5,
      "room": 4
    },
    {
      "do": "warp",
      "instance": 2,
      "world": 5,
      "room": 5
    },
    {
      "do": "relay"
    },
    {
      "do": "runtime",
      "instance": 0,
      "role": "player"
    },
    {
      "do": "runtime",
      "instance": 1,
      "role": "friend1"
    },
    {
      "do": "transition_check",
      "instances": [
        0,
        1
      ],
      "as": "initial",
      "target": [
        4,
        26
      ]
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 5,
      "room": 1
    },
    {
      "do": "transition_check",
      "instances": [
        0,
        1
      ],
      "as": "before_late_join",
      "after": "initial",
      "target": [
        5,
        1
      ]
    },
    {
      "do": "assert",
      "expr": "location(2)[:2] != location(0)[:2]",
      "message": "late join fixture must begin in a different room"
    },
    {
      "do": "runtime",
      "instance": 2,
      "role": "friend2"
    },
    {
      "do": "transition_check",
      "as": "joined",
