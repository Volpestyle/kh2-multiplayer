{
  "name": "net_host_transitions_smoke",
  "description": "VUH-1496 smoke: host plus two clients; delayed third runtime joins from a different room and acknowledges the existing epoch; two further host transitions include an exact same-room reload. Each checkpoint checks all six location fields, real-load epochs, relay ACKs, puppet ownership and native friend-slot poses. Hashes and natural exits require supplementary evidence.",
  "steps": [
    {
      "do": "boot",
      "instance": 0
    },
    {
      "do": "boot",
      "instance": 1
    },
    {
      "do": "boot",
      "instance": 2
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 4,
      "room": 26
    },
    {
      "do": "warp",
      "instance": 1,
      "world": 5,
      "room": 4
    },
    {
      "do": "warp",
      "instance": 2,
      "world": 5,
      "room": 5
    },
    {
      "do": "relay"
    },
    {
      "do": "runtime",
      "instance": 0,
      "role": "player"
    },
    {
      "do": "runtime",
      "instance": 1,
      "role": "friend1"
    },
    {
      "do": "transition_check",
      "instances": [
        0,
        1
      ],
      "as": "initial",
      "target": [
        4,
        26
      ]
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 5,
      "room": 1
    },
    {
      "do": "transition_check",
      "instances": [
        0,
        1
      ],
      "as": "before_late_join",
      "after": "initial",
      "target": [
        5,
        1
      ]
    },
    {
      "do": "assert",
      "expr": "location(2)[:2] != location(0)[:2]",
      "message": "late join fixture must begin in a different room"
    },
    {
      "do": "runtime",
      "instance": 2,
      "role": "friend2"
    },
    {
      "do": "transition_check",
      "as": "joined",
      "target": [
        5,
        1
      ],
      "capture": true
    },
    {
      "do": "assert",
      "expr": "saved['joined']['epoch'] == saved['before_late_join']['epoch']",
      "message": "late join should follow the current host epoch without advancing it"
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 5,
      "room": 4
    },
    {
      "do": "transition_check",
      "as": "transition_01",
      "after": "joined",
      "target": [
        5,
        4
      ]
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 5,
      "room": 4
    },
    {
      "do": "transition_check",
      "as": "transition_02",
      "after": "transition_01",
      "target": [
        5,
        4
      ]
    },
    {
      "do": "assert",
      "expr": "saved['transition_01']['instances']['0']['location'] == saved['transition_02']['instances']['0']['location']",
      "message": "same-room reload fixture changed a location field"
    },
    {
      "do": "capture",
      "instance": 0,
      "name": "smoke_end"
    },
    {
      "do": "capture",
      "instance": 1,
      "name": "smoke_end"
    },
    {
      "do": "capture",
      "instance": 2,
      "name": "smoke_end"
    }
  ],
  "protect": [
    0,
    1,
    2
  ]
}
