{
 "name": "net_lod_shanyu",
 "description": "VUH-2342: Shan-Yu's room 08/09 programs 75 (B_MU100 + hawk B_MU110, mission MU09_MS108 with the GATES gauge). Both fight until Shan-Yu is defeated (up to ~340 s), with enemy HP, both missions and the friend's position sampled every 2 s. Afterwards the friend must follow the host to the next location without a crash or a stuck friend.",
 "playerDefaults": true,
 "protect": [
  0,
  1
 ],
 "steps": [
  {
   "do": "boot",
   "instance": 0,
   "initTimeoutMs": 60000
  },
  {
   "do": "boot",
   "instance": 1,
   "initTimeoutMs": 60000
  },
  {
   "do": "warp",
   "instance": 0,
   "world": 4,
   "room": 26
  },
  {
   "do": "warp",
   "instance": 1,
   "world": 4,
   "room": 26
  },
  {
   "do": "relay",
   "port": 27798,
   "args": [
    "--bind",
    "127.0.0.1"
   ]
  },
  {
   "do": "runtime",
   "instance": 0,
   "role": "player"
  },
  {
   "do": "runtime",
   "instance": 1,
   "role": "friend1"
  },
  {
   "do": "wait_until",
   "expr": "all((bridge(i).get('puppet0') or {}).get('active') for i in range(2))",
   "timeoutMs": 30000,
   "pollMs": 1000
  },
  {
   "do": "warp",
   "instance": 0,
   "world": 8,
   "room": 9,
   "door": 0,
   "map": 75,
   "btl": 75,
   "evt": 0
  },
  {
   "do": "wait_until",
   "expr": "location(0)[:2]==[8,9] and location(1)[:2]==[8,9]",
   "timeoutMs": 45000
  },
  {
   "do": "checkpoint",
   "name": "1 Shan-Yu fight with the friend present"
  },
  {
   "do": "wait",
   "ms": 4000
  },
  {
   "do": "press",
   "instance": 1,
   "button": "confirm",
   "times": 2,
   "gapMs": 700
  },
  {
   "do": "fight",
   "instances": [
    0,
    1
   ],
   "seconds": 100,
   "as": "fight1",
   "sample": {
    "expr": "[mission(0), mission(1), enemy_hps(0), enemy_hps(1), pos('P_EX100',1)]",
    "everyMs": 2000
   },
   "clips": [
    {
     "instance": 0,
     "seconds": 25,
     "fps": 15,
     "name": "shanyu_host"
    },
    {
     "instance": 1,
     "seconds": 25,
     "fps": 15,
     "name": "shanyu_friend"
    }
   ]
  },
  {
   "do": "fight",
   "instances": [
    0,
    1
   ],
   "seconds": 120,
   "as": "fight2",
   "sample": {
    "expr": "[mission(0), mission(1), enemy_hps(0), enemy_hps(1), pos('P_EX100',1)]",
    "everyMs": 2000
   }
  },
  {
   "do": "fight",
   "instances": [
    0,
    1
   ],
   "seconds": 120,
   "as": "fight3",
   "sample": {
    "expr": "[mission(0), mission(1), enemy_hps(0), enemy_hps(1), pos('P_EX100',1)]",
    "everyMs": 2000
   }
  },
  {
   "do": "save",
   "as": "after_fight",
   "expr": "[enemy_hps(0), enemy_hps(1), location(0), location(1), mission(0), mission(1)]"
  },
  {
   "do": "checkpoint",
   "name": "2 Shan-Yu defeated on both; the friend continues with the host"
  },
  {
   "do": "wait_until",
   "expr": "not any(n=='B_MU100' for n,h in enemy_hps(0))",
   "timeoutMs": 20000
  },
  {
   "do": "clip",
   "instance": 1,
   "seconds": 20,
   "fps": 15,
   "name": "defeat_friend",
   "background": true
  },
  {
   "do": "wait_until",
   "expr": "log_count('[mission-mirror] client end like the host',1)>=1 and not any(n=='B_MU100' for n,h in enemy_hps(1))",
   "timeoutMs": 40000,
   "pollMs": 1000
  },
  {
   "do": "clip_wait"
  },
  {
   "do": "save",
   "as": "after_defeat",
   "expr": "[enemy_hps(0), enemy_hps(1), mission(0), mission(1), location(0), location(1)]"
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "defeat_host"
  },
  {
   "do": "capture",
   "instance": 1,
   "name": "defeat_friend"
  },
  {
   "do": "checkpoint",
   "name": "3 The host moves on; the friend follows and can move"
  },
  {
   "do": "warp",
   "instance": 0,
   "world": 8,
   "room": 0
  },
  {
   "do": "wait_until",
   "expr": "location(0)[:2]==[8,0] and location(1)[:2]==[8,0]",
   "timeoutMs": 60000,
   "pollMs": 1000
  },
  {
   "do": "wait",
   "ms": 4000
  },
  {
   "do": "save",
   "as": "moved_from",
   "expr": "pos('P_EX100',1)"
  },
  {
   "do": "input",
   "instance": 1,
   "ly": 1,
   "ms": 800
  },
  {
   "do": "wait",
   "ms": 400
  },
  {
   "do": "save",
   "as": "moved_to",
   "expr": "pos('P_EX100',1)"
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "after_host"
  },
  {
   "do": "capture",
   "instance": 1,
   "name": "after_friend"
  },
  {
   "do": "assert",
   "expr": "dist(saved['moved_from'],saved['moved_to'])>20",
   "message": "the friend could not move after following the host"
  }
 ]
}
