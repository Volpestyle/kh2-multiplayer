{
  "name": "net_native_party_hud",
  "playerDefaults": true,
  "description": "VUH-2568 single-PC loopback, two Soras in GoA. Native party portraits and authoritative HP/MP in both directions. Guest owner HP 80->69 and MP 10->3->0->10 are RAM-controlled (not a native cast). Host takes native test-hit damage 7, casts real Fire using temporary RAM Fire unlock/10-MP setup, and naturally recharges. One same-room reload. Local HUD remains native. No saves; this is not two-PC acceptance.",
  "steps": [
    {
      "do": "boot",
      "instance": 0,
      "initTimeoutMs": 60000,
      "env": {
        "KH2COOP_PROFILE": "0x54"
      }
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 4,
      "room": 26
    },
    {
      "do": "boot",
      "instance": 1,
      "initTimeoutMs": 60000,
      "env": {
        "KH2COOP_PROFILE": "0x54"
      }
    },
    {
      "do": "warp",
      "instance": 1,
      "world": 4,
      "room": 26
    },
    {
      "do": "relay",
      "port": 27808,
      "args": [
        "--bind",
        "127.0.0.1"
      ]
    },
    {
      "do": "runtime",
      "instance": 0,
      "role": "player"
    },
    {
      "do": "runtime",
      "instance": 1,
      "role": "friend1"
    },
    {
      "do": "wait_until",
      "expr": "all((bridge(i).get('puppet0') or {}).get('active') for i in range(2))",
      "timeoutMs": 30000,
      "pollMs": 1000
    },
    {
      "do": "wait_until",
      "expr": "all(log_count('[nativehud] slot=0 owner='+str(1-i),i)>0 for i in range(2))",
      "timeoutMs": 15000
    },
    {
      "do": "wait",
      "ms": 3000
    },
    {
      "do": "input",
      "instance": 0,
      "lx": 1,
      "ms": 1500
    },
    {
      "do": "input",
      "instance": 1,
      "lx": 1,
      "ms": 1500
    },
    {
      "do": "wait",
      "ms": 1000
    },
    {
      "do": "save",
      "as": "local",
      "expr": "[int(peek(0x2A105D0,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "save",
      "as": "status",
      "expr": "[int(peek_at(saved['local'][i]+0x5C0,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "save",
      "as": "gauges",
      "expr": "[int(peek(0xABD250,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "save",
      "as": "views",
      "expr": "[int(peek_at(saved['gauges'][i]+0x40,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "assert",
      "expr": "all(saved['views'][i] and saved['views'][i]!=saved['local'][i] for i in range(2))",
      "message": "native friend gauge did not bind a display view"
    },
    {
      "do": "save",
      "as": "hud_status",
      "expr": "[int(peek_at(saved['views'][i]+0x5C0,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "save",
      "as": "fire_before",
      "expr": "[peek(0x9ACE44,'u8',i) for i in range(2)]"
    },
    {
      "do": "save",
      "as": "command_before",
      "expr": "[{'flags':peek(0x2A10644,'u32',i),'spellCount':peek(0x2A107D8,'i32',i),'boundActor':peek(0x2A11100,'u64',i),'charge':peek_at(saved['status'][i]+0x1BC,'f32',i),'chargeMax':peek_at(saved['status'][i]+0x1C0,'f32',i),'form':peek_at(saved['local'][i]+0xDE0,'i32',i)} for i in range(2)]"
    },
    {
      "do": "checkpoint",
      "name": "Single-PC loopback: each Sora owns 80 HP and 10 MP; Fire is temporarily available in RAM"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--rva','0x9ACE44','--type','u8','--value',str(max(1,saved['fire_before'][0]))]"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--addr',str(saved['status'][0]+4),'--type','i32','--value','80']"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--addr',str(saved['status'][0]+0),'--type','i32','--value','80']"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--addr',str(saved['status'][0]+388),'--type','i32','--value','10']"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--addr',str(saved['status'][0]+384),'--type','i32','--value','10']"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--rva','0x9ACE44','--type','u8','--value',str(max(1,saved['fire_before'][1]))]"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(saved['status'][1]+4),'--type','i32','--value','80']"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(saved['status'][1]+0),'--type','i32','--value','80']"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(saved['status'][1]+388),'--type','i32','--value','10']"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(saved['status'][1]+384),'--type','i32','--value','10']"
    },
    {
      "do": "wait_until",
      "expr": "peek_at(saved['hud_status'][0]+0,'i32',0)==80 and peek_at(saved['hud_status'][1]+0,'i32',1)==80 and peek_at(saved['hud_status'][0]+384,'i32',0)==10 and peek_at(saved['hud_status'][1]+384,'i32',1)==10",
      "timeoutMs": 10000
    },
    {
      "do": "save",
      "as": "command_after",
      "expr": "[{'flags':peek(0x2A10644,'u32',i),'spellCount':peek(0x2A107D8,'i32',i),'boundActor':peek(0x2A11100,'u64',i),'chargeMax':peek_at(saved['status'][i]+0x1C0,'f32',i)} for i in range(2)]"
    },
    {
      "do": "assert",
      "expr": "all(peek(0x2A107D8,'i32',i)>0 for i in range(2))",
      "message": "no native spells available in setup"
    },
    {
      "do": "capture",
      "instance": 0,
      "name": "native_party_full"
    },
    {
      "do": "clip",
      "instance": 0,
      "seconds": 20,
      "fps": 20,
      "name": "reciprocal_damage_fire",
      "background": true
    },
    {
      "do": "capture",
      "instance": 1,
      "name": "native_party_full"
    },
    {
      "do": "clip",
      "instance": 1,
      "seconds": 20,
      "fps": 20,
      "name": "reciprocal_damage_fire",
      "background": true
    },
    {
      "do": "checkpoint",
      "name": "RAM-controlled guest owner: HP 80 -> 69, MP 10 -> 3 -> 0; host native HUD follows"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(saved['status'][1]+0),'--type','i32','--value','69']"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(saved['status'][1]+384),'--type','i32','--value','3']"
    },
    {
      "do": "wait_until",
      "expr": "peek_at(saved['hud_status'][0]+0,'i32',0)==69 and peek_at(saved['hud_status'][0]+384,'i32',0)==3",
      "timeoutMs": 5000,
      "message": "host native HUD did not show the guest's RAM-controlled owner HP/MP"
    },
    {
      "do": "save",
      "as": "controlled_guest_partial",
      "expr": "{'ownerHP':peek_at(saved['status'][1],'i32',1),'ownerMP':peek_at(saved['status'][1]+0x180,'i32',1),'hostHUD_HP':peek_at(saved['hud_status'][0],'i32',0),'hostHUD_MP':peek_at(saved['hud_status'][0]+0x180,'i32',0)}"
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(saved['status'][1]+0x180),'--type','i32','--value','0']"
    },
    {
      "do": "wait_until",
      "expr": "peek_at(saved['hud_status'][0]+0,'i32',0)==69 and peek_at(saved['hud_status'][0]+384,'i32',0)==0",
      "timeoutMs": 5000
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "do": "checkpoint",
      "name": "Host takes native test-hit damage 7 and casts real Fire; guest native HUD follows"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['hit','damage','--victim',str(saved['local'][0]),'--amount','7']"
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "press",
      "instance": 0,
      "button": "down",
      "ms": 40
    },
    {
      "do": "wait",
      "ms": 250
    },
    {
      "do": "press",
      "instance": 0,
      "button": "cross",
      "ms": 60
    },
    {
      "do": "wait",
      "ms": 350
    },
    {
      "do": "press",
      "instance": 0,
      "button": "cross",
      "ms": 60
    },
    {
      "do": "wait_until",
      "expr": "peek_at(saved['status'][0]+384,'i32',0)==0",
      "timeoutMs": 8000,
      "message": "native host Fire did not consume 10 MP"
    },
    {
      "do": "wait_until",
      "expr": "peek_at(saved['hud_status'][1]+0,'i32',1)==73 and peek_at(saved['hud_status'][1]+384,'i32',1)==0",
      "timeoutMs": 5000,
      "message": "guest native party HUD did not show host damage and MP use"
    },
    {
      "do": "assert",
      "expr": "peek_at(saved['status'][0]+0,'i32',0)==73",
      "message": "host native test-hit damage did not match"
    },
    {
      "do": "clip_wait"
    },
    {
      "do": "save",
      "as": "after_hits_casts",
      "expr": "[{'ownHP':peek_at(saved['status'][i],'i32',i),'ownMP':peek_at(saved['status'][i]+0x180,'i32',i),'remoteHP':peek_at(saved['hud_status'][i],'i32',i),'remoteMP':peek_at(saved['hud_status'][i]+0x180,'i32',i)} for i in range(2)]"
    },
    {
      "do": "checkpoint",
      "name": "Host naturally recharges; guest MP is restored in RAM; both remote gauges follow"
    },
    {
      "do": "wait_until",
      "expr": "peek_at(saved['status'][0]+384,'i32',0)==10",
      "timeoutMs": 120000,
      "pollMs": 1000
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(saved['status'][1]+0x180),'--type','i32','--value','10']"
    },
    {
      "do": "wait_until",
      "expr": "peek_at(saved['hud_status'][0]+384,'i32',0)==10 and peek_at(saved['hud_status'][1]+384,'i32',1)==10",
      "timeoutMs": 5000
    },
    {
      "do": "clip",
      "instance": 0,
      "seconds": 4,
      "fps": 20,
      "name": "native_mp_recharged",
      "background": true
    },
    {
      "do": "clip",
      "instance": 1,
      "seconds": 4,
      "fps": 20,
      "name": "native_mp_recharged",
      "background": true
    },
    {
      "do": "clip_wait"
    },
    {
      "do": "capture",
      "instance": 0,
      "name": "native_party_recharged"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--rva','0x9ACE44','--type','u8','--value',str(saved['fire_before'][0])]"
    },
    {
      "do": "capture",
      "instance": 1,
      "name": "native_party_recharged"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--rva','0x9ACE44','--type','u8','--value',str(saved['fire_before'][1])]"
    },
    {
      "do": "checkpoint",
      "name": "Host reloads the same room: native friend HUD binds fresh views without duplicate slots"
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 4,
      "room": 26
    },
    {
      "do": "wait",
      "ms": 5000
    },
    {
      "do": "wait_until",
      "expr": "all((bridge(i).get('puppet0') or {}).get('active') for i in range(2))",
      "timeoutMs": 30000,
      "pollMs": 1000
    },
    {
      "do": "save",
      "as": "local",
      "expr": "[int(peek(0x2A105D0,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "save",
      "as": "status",
      "expr": "[int(peek_at(saved['local'][i]+0x5C0,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "save",
      "as": "gauges",
      "expr": "[int(peek(0xABD250,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "save",
      "as": "views",
      "expr": "[int(peek_at(saved['gauges'][i]+0x40,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "assert",
      "expr": "all(saved['views'][i] and saved['views'][i]!=saved['local'][i] for i in range(2))",
      "message": "native friend gauge did not bind a display view"
    },
    {
      "do": "save",
      "as": "hud_status",
      "expr": "[int(peek_at(saved['views'][i]+0x5C0,'u64',i),16) for i in range(2)]"
    },
    {
      "do": "capture",
      "instance": 0,
      "name": "native_party_after_reload"
    },
    {
      "do": "capture",
      "instance": 1,
      "name": "native_party_after_reload"
    }
  ]
}
