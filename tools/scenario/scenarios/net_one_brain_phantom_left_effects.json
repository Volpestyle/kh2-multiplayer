{
 "name": "net_one_brain_phantom_left_effects",
 "description": "VUH-2304: let the first-wave Magic Phantom escape alive in HB04/15, then require its original body gone on both friends. The host withdraws after combat so the native distance escape runs. No spawn-controller gating.",
 "protect": [
  0,
  1,
  2
 ],
 "steps": [
  {
   "do": "boot",
   "instance": 0,
   "env": {
    "KH2COOP_ENEMY_MIRROR": "1",
    "KH2COOP_ENEMY_POPULATION": "1",
    "KH2COOP_ENEMY_TARGET_ALL": "1"
   },
   "initTimeoutMs": 60000
  },
  {
   "do": "boot",
   "instance": 1,
   "env": {
    "KH2COOP_ENEMY_MIRROR": "1",
    "KH2COOP_ENEMY_POPULATION": "1",
    "KH2COOP_ENEMY_TARGET_ALL": "1"
   },
   "initTimeoutMs": 60000
  },
  {
   "do": "boot",
   "instance": 2,
   "env": {
    "KH2COOP_ENEMY_MIRROR": "1",
    "KH2COOP_ENEMY_POPULATION": "1",
    "KH2COOP_ENEMY_TARGET_ALL": "1"
   },
   "initTimeoutMs": 60000
  },
  {
   "do": "relay",
   "port": 27796,
   "args": [
    "--bind",
    "127.0.0.1"
   ]
  },
  {
   "do": "runtime",
   "instance": 0,
   "role": "player",
   "env": {
    "KH2COOP_COOP_DIFFICULTY": "normal"
   }
  },
  {
   "do": "runtime",
   "instance": 1,
   "role": "friend1",
   "env": {
    "KH2COOP_COOP_DIFFICULTY": "normal"
   }
  },
  {
   "do": "runtime",
   "instance": 2,
   "role": "friend2",
   "env": {
    "KH2COOP_COOP_DIFFICULTY": "normal"
   }
  },
  {
   "do": "warp",
   "instance": 0,
   "world": 4,
   "room": 21,
   "door": 0,
   "map": 1,
   "btl": 26,
   "evt": 32767
  },
  {
   "do": "wait_until",
   "timeoutMs": 30000,
   "expr": "location(0)==[4, 21, 0, 1, 26, 32767] and location(1)==location(0) and location(2)==location(0) and all(any(a['name']=='P_EX100' for a in actors(i)) for i in range(3))"
  },
  {
   "do": "kh2ctl",
   "instance": 0,
   "argsExpr": "['poke','--addr',str(int(actor('P_EX100',0)['address'],16)+0x670),'--type','f32x3','--value','859.696,450,-599.768']"
  },
  {
   "do": "kh2ctl",
   "instance": 1,
   "argsExpr": "['poke','--addr',str(int(actor('P_EX100',1)['address'],16)+0x670),'--type','f32x3','--value','919.696,450,-599.768']"
  },
  {
   "do": "kh2ctl",
   "instance": 2,
   "argsExpr": "['poke','--addr',str(int(actor('P_EX100',2)['address'],16)+0x670),'--type','f32x3','--value','799.696,450,-599.768']"
  },
  {
   "do": "wait_until",
   "timeoutMs": 25000,
   "expr": "all(any(a['objectId']==2403 and a['hp']>0 for a in enemies(i)) for i in range(3)) and enemy_hps(0)==enemy_hps(1) and enemy_hps(0)==enemy_hps(2)"
  },
  {
   "do": "save",
   "as": "first_phantoms",
   "expr": "[[a['address'] for a in enemies(i) if a['objectId']==2403 and a['hp']>0] for i in range(3)]"
  },
  {
   "do": "save",
   "as": "field_objects_start",
   "expr": "[sorted([(a['name'], a.get('objectType'), a.get('objectId'), a.get('motionId'), [round(a['position'][k]) for k in ('x', 'y', 'z')] if a.get('position') else None) for a in actors(i) if a['name'].startswith('F_')]) for i in range(3)]"
  },
  {
   "do": "clip",
   "instance": 1,
   "seconds": 3,
   "fps": 10,
   "name": "phantom_before_friend1"
  },
  {
   "do": "fight",
   "instances": [
    0,
    1,
    2
   ],
   "seconds": 3,
   "as": "hb_fight",
   "clip": {
    "instance": 1,
    "seconds": 3,
    "fps": 10,
    "name": "hb_fight_friend1"
   }
  },
  {
   "do": "kh2ctl",
   "instance": 0,
   "argsExpr": "['poke','--addr',str(int(actor('P_EX100',0)['address'],16)+0x670),'--type','f32x3','--value','-2200,450,-600']"
  },
  {
   "do": "wait_until",
   "timeoutMs": 30000,
   "expr": "log_count('netId 2 (despawned, not refilled, left=1)',0)>0"
  },
  {
   "do": "wait_until",
   "timeoutMs": 10000,
   "expr": "all(log_count('host leave netId 2 objectId 2403 applied',i)>0 for i in (1,2))"
  },
  {
   "do": "wait_until",
   "timeoutMs": 2500,
   "expr": "all(not any(a['address'] in saved['first_phantoms'][i] for a in enemies(i)) for i in (1,2))"
  },
  {
   "do": "assert",
   "expr": "all(log_count('leave-effects-ended',i)>0 for i in (1,2))",
   "message": "Both friends must exercise native effect cleanup"
  },
  {
   "do": "save",
   "as": "after_leave",
   "expr": "[enemy_hps(i) for i in range(3)]"
  },
  {
   "do": "save",
   "as": "cleanup",
   "expr": "[log_matches(r'(?P<line>leave-effects-ended.*|stray-gone.*|removal-terms.*)',i) for i in (1,2)]"
  },
  {
   "do": "assert",
   "expr": "all(log_count('leave-effects-fault',i)==0 for i in (1,2))",
   "message": "Native effect cleanup faulted"
  },
  {
   "do": "clip",
   "instance": 0,
   "seconds": 3,
   "fps": 10,
   "name": "phantom_gone_0"
  },
  {
   "do": "clip",
   "instance": 1,
   "seconds": 3,
   "fps": 10,
   "name": "phantom_gone_1"
  },
  {
   "do": "clip",
   "instance": 2,
   "seconds": 3,
   "fps": 10,
   "name": "phantom_gone_2"
  },
  {
   "do": "wait",
   "ms": 4000
  },
  {
   "do": "assert",
   "expr": "all(not any(a['address'] in saved['first_phantoms'][i] for a in enemies(i)) for i in (1,2))",
   "message": "Escaped Phantom body returned"
  }
 ]
}
