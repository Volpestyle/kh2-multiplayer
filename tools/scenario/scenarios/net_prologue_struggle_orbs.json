  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "wait_until",
   "expr": "log_count('control released at=02/05 evt=84 site=tt05-84', 0) > 0 and log_count('control released at=02/05 evt=84 site=tt05-84', 1) > 0",
   "timeoutMs": 90000,
   "pollMs": 500
  },
  {
   "do": "assert",
   "expr": "all(len([a for a in actors(i) if a['name']=='P_EX110']) == 2 for i in (0, 1))",
   "message": "both seats must hold both Roxases at tt05-84"
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "released_host"
  },
  {
   "do": "capture",
   "instance": 1,
   "name": "released_friend"
  },
  {
   "do": "assert",
   "expr": "log_count('[struggle-orbs] configured=1 hooked=1', 0) == 1 and log_count('[struggle-orbs] configured=1 hooked=1', 1) == 1",
   "message": "the orb hooks must be installed on both seats"
  },
  {
   "do": "fight",
   "instances": [
    0,
    1
   ],
   "seconds": 240,
   "reach": 250,
   "as": "fight",
   "until": "log_count('[mission-mirror] host end trap=', 0) > 0 or log_count('client end like the host', 1) + log_count('client fail like the host', 1) > 0",
   "clips": [
    {
     "instance": 0,
     "seconds": 30,
     "fps": 30,
     "name": "match_host"
    },
    {
     "instance": 1,
     "seconds": 30,
     "fps": 30,
     "name": "match_friend"
    }
   ]
  },
  {
   "do": "wait",
   "ms": 8000
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "after_host"
  },
  {
   "do": "capture",
   "instance": 1,
   "name": "after_friend"
  },
  {
   "do": "save",
   "as": "orbs",
   "expr": "{'hostSent': log_count('[struggle-orbs] sent epoch=', 0), 'friendReceived': log_count('[struggle-orbs] received epoch=', 1), 'hostStats': [m['l'] for m in log_matches(r'(?P<l>\\[struggle-orbs\\] stats .*)', 0)][-1:], 'friendStats': [m['l'] for m in log_matches(r'(?P<l>\\[struggle-orbs\\] stats .*)', 1)][-1:], 'friendShown': [m['l'] for m in log_matches(r'(?P<l>\\[struggle-orbs\\] client shown.*)', 1)][-1:], 'cloneCollects': len(log_matches(r'\\[struggle-orbs\\] sent .*collector=2 ', 0)), 'ends': [log_count('[mission-mirror] host end trap=', 0), log_count('client end like the host', 1) + log_count('client fail like the host', 1)]}"
  },
  {
   "do": "assert",
   "expr": "saved['orbs']['hostSent'] > 0 and saved['orbs']['friendReceived'] > 0",
   "message": "the host's orb rows must reach the friend"
  },
  {
   "do": "assert",
   "expr": "len(log_matches(r'\\[struggle-orbs\\] thread site=NoteGameThread tid=\\d+ gameTid=\\d+', 0)) > 0 and len(log_matches(r'\\[struggle-orbs\\] thread site=NoteGameThread tid=\\d+ gameTid=\\d+', 1)) > 0 and len(log_matches(r'\\[struggle-orbs\\] thread site=pick-[ab] tid=\\d+ gameTid=\\d+', 0)) > 0 and len(log_matches(r'\\[struggle-orbs\\] thread site=pick-[ab] tid=\\d+ gameTid=\\d+', 1)) > 0 and all(len(log_matches(r'\\[struggle-orbs\\] thread site=' + site + r' tid=\\d+ gameTid=\\d+', 0)) > 0 for site in ('create', 'init', 'fly'))",
   "message": "orb hook and entity-thread TIDs must be recorded on both seats"
  },
  {
   "do": "assert",
   "expr": "len(log_matches(r'\\[struggle-orbs\\] stats .*queued=[1-9]\\d* drained=[1-9]\\d* stale=\\d+ overflow=0', 0)) > 0 and len(log_matches(r'\\[struggle-orbs\\] stats .*overflow=0', 1)) > 0 and len(log_matches(r'\\[struggle-orbs\\] stats .*overflow=[1-9]', 0)) == 0 and len(log_matches(r'\\[struggle-orbs\\] stats .*overflow=[1-9]', 1)) == 0",
   "message": "worker receipts must reach the entity thread without mailbox overflow; offThread counts are expected observations"
  },
  {
   "do": "assert",
   "expr": "len(log_matches(r'\\[struggle-orbs\\] stats .*collects=[1-9]', 0)) > 0 and len(log_matches(r'\\[struggle-orbs\\] sent .* collect orb=', 0)) > 0 and len(log_matches(r'\\[struggle-orbs\\] received .* collect orb=', 1)) > 0 and len(log_matches(r'\\[struggle-orbs\\] client shown=\\d+ created=\\d+ vanished=[1-9]', 1)) > 0 and len(log_matches(r'\\[struggle-orbs\\] stats .*dropsSuppressed=[1-9]\\d* picksSuppressed=[1-9]\\d*', 1)) > 0 and {(m['epoch'], m['seq'], m['orb']) for m in log_matches('\\\\[struggle-orbs\\\\] sent epoch=(?P<epoch>\\\\d+) seq=(?P<seq>\\\\d+) collect orb=(?P<orb>\\\\d+) ', 0)} == {(m['epoch'], m['seq'], m['orb']) for m in log_matches('\\\\[struggle-orbs\\\\] received epoch=(?P<epoch>\\\\d+) seq=(?P<seq>\\\\d+) collect orb=(?P<orb>\\\\d+)(?:\\\\s|$)', 1)} and len({(m['epoch'], m['orb']) for m in log_matches('\\\\[struggle-orbs\\\\] sent epoch=(?P<epoch>\\\\d+) seq=\\\\d+ collect orb=(?P<orb>\\\\d+) [^\\\\r\\\\n]*collector=2 ', 0)} & {(m['epoch'], m['orb']) for m in log_matches('\\\\[struggle-orbs\\\\] applied epoch=(?P<epoch>\\\\d+) collect orb=(?P<orb>\\\\d+) collector=2 netId=0 ok=1', 1)}) > 0",
   "message": "host pickups must be booked and sent, then received and flown or faded on the friend; matching collect IDs/epochs/sequences, a clone collect applied, and nonzero friend drop/pick suppression are required"
  },
  {
   "do": "assert",
   "expr": "log_count('client end like the host', 1) + log_count('client fail like the host', 1) == 1",
   "message": "the friend must end the match exactly once, like the host"
  },
  {
   "do": "coop_verdict",
   "as": "verdict",
   "require": false
  }
 ]
}
