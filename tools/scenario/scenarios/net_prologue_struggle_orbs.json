   "do": "kh2ctl",
   "instance": 0,
   "argsExpr": "['player-press', '--button', 'cross', '--duration-ms', '120'] if (peek('0xB65210','i32',0) != 0 or peek('0x2A11478','u32',0) != 0) else ['peek', '--rva', '0x9BA8D0:u8']"
