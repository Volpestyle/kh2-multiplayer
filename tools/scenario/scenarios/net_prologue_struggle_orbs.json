  {
   "do": "boot",
   "instance": 0,
   "slotMoves": -2,
   "initTimeoutMs": 60000,
   "env": {
    "KH2COOP_ENEMY_MIRROR_TRACE": "1"
   }
  },
  {
   "do": "boot",
   "instance": 1,
   "slotMoves": -2,
   "initTimeoutMs": 60000,
   "env": {
    "KH2COOP_ENEMY_MIRROR_TRACE": "1"
   }
  },
  {
   "do": "assert",
   "expr": "room(0)[0] == 2 and room(1)[0] == 2",
   "message": "the rehearsal save must load Twilight Town on both seats"
  },
  {
   "do": "relay",
   "port": 27841,
   "args": [
    "--bind",
    "127.0.0.1"
   ]
  },
  {
   "do": "runtime",
   "instance": 0,
   "role": "player"
  },
  {
   "do": "runtime",
   "instance": 1,
   "role": "friend1"
  },
  {
   "do": "wait_until",
   "expr": "log_count('[enemysync] client arrived epoch=', 1) > 0",
   "timeoutMs": 60000
  },
  {
   "do": "hang_check",
   "instance": 0,
   "on": false
  },
  {
   "do": "hang_check",
   "instance": 1,
   "on": false
  },
  {
   "do": "wait_until",
   "expr": "log_count('[prologue] unpinned start', 0) > 0 and log_count('[prologue] unpinned start', 1) > 0",
   "timeoutMs": 60000,
   "pollMs": 500
  },
  {
   "do": "warp",
   "instance": 0,
   "world": 2,
   "room": 5,
   "door": 0,
   "map": 84,
   "btl": 84,
   "evt": 84
  },
  {
   "do": "wait_until",
   "expr": "location(0)[1] == 5",
   "timeoutMs": 60000,
   "pollMs": 200
