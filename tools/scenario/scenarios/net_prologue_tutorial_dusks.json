   "do": "capture",
   "instance": 1,
   "name": "after_friend"
  },
  {
   "do": "save",
   "as": "combat",
   "expr": "{'hostDeaths': log_count('[enemysync] host death epoch', 0) - saved['deaths_before'], 'friendApplied': log_count('client: host death netId', 1), 'friendClaims': len(log_matches(r'host hit claim .* damage=[1-9]', 0)), 'duskHitsHostLog': len(log_matches(r'\\[hit\\] .*attacker=M_EX9\\d0 .*-> victim=P_EX110', 0)), 'duskHitsFriendLog': len(log_matches(r'\\[hit\\] .*attacker=M_EX9\\d0 .*-> victim=P_EX110', 1)), 'ends': [log_count('[mission-mirror] host end trap=', 0), log_count('client end like the host', 1) + log_count('client fail like the host', 1)]}"
  },
  {
   "do": "assert",
   "expr": "saved['combat']['hostDeaths'] >= 3 and all(not any(a.get('objectId')==318 and a.get('hp',-1)>0 for a in actors(i)) for i in (0, 1))",
   "message": "all three tutorial Dusks must die on both seats"
  },
  {
   "do": "assert",
   "expr": "saved['combat']['friendClaims'] >= 1",
   "message": "the friend's hits must reach the host as damage claims"
  },
  {
   "do": "assert",
   "expr": "saved['combat']['duskHitsHostLog'] >= 1 and saved['combat']['duskHitsFriendLog'] >= 1",
   "message": "a Dusk must land a native hit on a Roxas in each seat's game"
  },
  {
   "do": "assert",
   "expr": "log_count('client end like the host', 1) + log_count('client fail like the host', 1) <= 1",
   "message": "the friend must not end the mission twice"
  },
