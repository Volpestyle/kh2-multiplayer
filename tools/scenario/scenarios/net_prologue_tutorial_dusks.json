  {
   "do": "wait_until",
   "expr": "log_count('control released at=02/20 evt=154 site=tt32-154', 0) > 0 and log_count('control released at=02/20 evt=154 site=tt32-154', 1) > 0",
   "timeoutMs": 90000,
   "pollMs": 500
  },
  {
   "do": "assert",
   "expr": "all(len([a for a in actors(i) if a['name']=='P_EX110']) == 2 for i in (0, 1))",
   "message": "both seats must hold both Roxases at tt32-154"
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "released_host"
  },
  {
   "do": "capture",
   "instance": 1,
   "name": "released_friend"
  },
  {
   "do": "save",
   "as": "deaths_before",
   "expr": "log_count('[enemysync] host death epoch', 0)"
  },
  {
   "do": "fight",
   "instances": [
    0,
    1
   ],
   "seconds": 180,
   "reach": 250,
   "as": "fight",
   "until": "log_count('[enemysync] host death epoch', 0) >= saved['deaths_before'] + 3",
   "clips": [
    {
     "instance": 0,
     "seconds": 30,
     "fps": 30,
     "name": "tutorial_host"
    },
    {
     "instance": 1,
     "seconds": 30,
     "fps": 30,
     "name": "tutorial_friend"
    }
   ]
