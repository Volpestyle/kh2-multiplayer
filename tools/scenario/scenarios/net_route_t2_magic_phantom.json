{
  "name": "net_route_t2_magic_phantom",
  "description": "VUH-1789 retained T2 Magic Phantom2403: host Normal 1.6 HP on both peers, native purple shots visible on friend, shared deaths. Boost only each owned local Sora in RAM to survive the casting window; no saves.",
  "protect": [
    0,
    1
  ],
  "steps": [
    {
      "do": "boot",
      "instance": 0,
      "env": {
        "KH2COOP_ENEMY_MIRROR": "1",
        "KH2COOP_ENEMY_POPULATION": "1",
        "KH2COOP_ENEMY_TARGET_ALL": "1",
        "KH2COOP_ENEMY_MIRROR_TRACE": "1"
      },
      "initTimeoutMs": 60000
    },
    {
      "do": "boot",
      "instance": 1,
      "env": {
        "KH2COOP_ENEMY_MIRROR": "1",
        "KH2COOP_ENEMY_POPULATION": "1",
        "KH2COOP_ENEMY_TARGET_ALL": "1",
        "KH2COOP_ENEMY_MIRROR_TRACE": "1"
      },
      "initTimeoutMs": 60000
    },
    {
      "do": "relay",
      "port": 27796,
      "args": [
        "--bind",
        "127.0.0.1"
      ]
    },
    {
      "do": "runtime",
      "instance": 0,
      "role": "player",
      "env": {
        "KH2COOP_COOP_DIFFICULTY": "normal"
      }
    },
    {
      "do": "runtime",
      "instance": 1,
      "role": "friend1",
      "env": {
        "KH2COOP_COOP_DIFFICULTY": "normal"
      }
    },
    {
      "do": "warp",
      "instance": 0,
      "world": 4,
      "room": 21,
      "door": 0,
      "map": 1,
      "btl": 26,
      "evt": 32767
    },
    {
      "do": "wait_until",
      "expr": "location(0)==[4,21,0,1,26,32767] and location(1)==location(0) and all(any(a['name']=='P_EX100' for a in actors(i)) for i in range(2))",
      "timeoutMs": 30000
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--addr',str(int(actor('P_EX100',0)['address'],16)+0x670),'--type','f32x3','--value','859.696,450,-599.768']"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(int(actor('P_EX100',1)['address'],16)+0x670),'--type','f32x3','--value','919.696,450,-599.768']"
    },
    {
      "do": "wait_until",
      "expr": "all(any(a['objectId']==oid and a['hp']>0 for a in enemies(i)) for i in range(2) for oid in [2403]) and enemy_hps(0)==enemy_hps(1)",
      "timeoutMs": 20000
    },
    {
      "do": "protect",
      "instance": 0,
      "on": false
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--addr',str(int(actor('P_EX100',0)['status'],16)+4),'--type','u32','--value','999']"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--addr',str(int(actor('P_EX100',0)['status'],16)+0),'--type','u32','--value','999']"
    },
    {
      "do": "kh2ctl",
      "instance": 0,
      "argsExpr": "['poke','--addr',str(int(actor('P_EX100',0)['address'],16)+0x4DC),'--type','u32','--value','1']"
    },
    {
      "do": "protect",
      "instance": 1,
      "on": false
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(int(actor('P_EX100',1)['status'],16)+4),'--type','u32','--value','999']"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(int(actor('P_EX100',1)['status'],16)+0),'--type','u32','--value','999']"
    },
    {
      "do": "kh2ctl",
      "instance": 1,
      "argsExpr": "['poke','--addr',str(int(actor('P_EX100',1)['address'],16)+0x4DC),'--type','u32','--value','1']"
    },
    {
      "do": "hit_all",
      "instance": 0,
      "op": "damage",
      "amount": 1
    },
    {
      "do": "wait",
      "ms": 6000
    },
    {
      "do": "save",
      "as": "casters",
      "expr": "[[a for a in enemies(i) if a['objectId']==2403] for i in range(2)]"
    },
    {
      "do": "assert",
      "expr": "all(len(peer)==1 and peer[0]['maxHp']==196 and peer[0]['hp']>0 for peer in saved['casters']) and enemy_hps(0)==enemy_hps(1)",
      "message": "Magic Phantom current/max HP did not mirror at two-player Normal"
    },
    {
      "do": "clip",
      "instance": 0,
      "seconds": 5,
      "fps": 6,
      "name": "host_magic_shots"
    },
    {
      "do": "clip",
      "instance": 1,
      "seconds": 5,
      "fps": 6,
      "name": "friend_magic_shots"
    },
    {
      "do": "hit_all",
      "instance": 0,
      "op": "kill"
    },
    {
      "do": "wait_until",
      "expr": "len(enemy_hps(0))==0 and len(enemy_hps(1))==0 and log_count('[enemysync] host death',0)>=3 and log_count('host death netId',1)>=3",
      "timeoutMs": 15000
    },
    {
      "do": "save",
      "as": "deaths",
      "expr": "[log_count('[enemysync] host death',0),log_count('host death netId',1)]"
    },
    {
      "do": "clip",
      "instance": 1,
      "seconds": 2,
      "fps": 6,
      "name": "friend_magic_dead"
    }
  ]
}
