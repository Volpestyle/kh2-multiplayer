   "do": "save",
   "as": "boss_friend_reverse2",
   "expr": "pos('P_EX100',2)"
  },
  {
   "do": "save",
   "as": "boss_friend_moved",
   "expr": "[max(dist(saved['boss_friend_pos'][i-1],saved[f'boss_friend_forward{i}']),dist(saved[f'boss_friend_forward{i}'],saved[f'boss_friend_reverse{i}'])) for i in (1,2)]"
  },
  {
   "do": "assert",
   "expr": "all(peek('0x7435D0','u8',i)==255 for i in (1,2)) and min(saved['boss_friend_moved'])>30",
   "message": "A friend did not move more than30 units in either direction during the boss fight, or a menu remained active"
  },
  {
   "do": "assert",
   "expr": "[runtime_log(i).count('Desync notice') for i in range(3)]==saved['notices_start']",
   "message": "A runtime logged a new desync notice during the boss fight"
  },
  {
   "do": "checkpoint",
   "name": "8 Boss: defeat and aftermath"
  },
  {
   "do": "save",
   "as": "notices_start",
   "expr": "[runtime_log(i).count('Desync notice') for i in range(3)]"
  },
  {
   "do": "assert",
   "expr": "location(0)[:2]==[5,11] and any(a.get('objectId')==353 and a['hp']>0 for a in enemies(0))",
   "message": "The boss fight was not reached, so there is no boss to defeat"
  },
  {
   "do": "save",
   "as": "defeat_events",
   "expr": "len(log_matches(r'\\[event-hold\\] observed active=1 ', 0))"
  },
  {
   "do": "hit_all",
   "instance": 0,
   "op": "kill"
  },
  {
   "do": "wait_until",
   "expr": "len(log_matches(r'\\[event-hold\\] observed active=1 ', 0))>saved['defeat_events'] and all(all(a['hp']<=1 for a in enemies(i) if a.get('objectId')==353) for i in range(3))",
   "timeoutMs": 30000
  },
  {
   "do": "clip",
   "instance": 2,
   "name": "boss_finish_friend2",
   "seconds": 8,
   "fps": 10
  },
  {
   "do": "wait",
   "ms": 4000
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "boss_after"
  },
  {
   "do": "capture",
   "instance": 1,
   "name": "boss_after"
  },
  {
   "do": "capture",
   "instance": 2,
   "name": "boss_after"
  },
  {
   "do": "clip",
   "instance": 2,
   "name": "boss_defeated_friend2",
   "seconds": 4,
   "fps": 6
  },
  {
   "do": "save",
   "as": "boss_aftermath_menu",
   "expr": "[peek('0x7435D0','u8',i) for i in range(3)]"
  },
  {
   "do": "wait_until",
   "expr": "location(1)==location(0) and location(2)==location(0)",
   "timeoutMs": 30000
  },
  {
   "do": "save",
   "as": "boss_aftermath_location",
   "expr": "[location(i) for i in range(3)]"
  },
  {
   "do": "checkpoint",
   "name": "9 Regroup in GoA: three players, no desync"
  },
  {
   "do": "save",
   "as": "notices_start",
   "expr": "[runtime_log(i).count('Desync notice') for i in range(3)]"
  },
  {
   "do": "warp",
   "instance": 0,
   "world": 4,
   "room": 26
  },
  {
   "do": "wait_until",
   "expr": "location(0)[:2]==[4,26] and location(1)==location(0) and location(2)==location(0)",
   "timeoutMs": 40000
  },
  {
   "do": "wait_until",
   "expr": "all((bridge(i).get(f'puppet{j}') or {}).get('active') for i in range(3) for j in range(2))",
   "timeoutMs": 20000,
   "pollMs": 1000
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "goa_regroup"
  },
  {
   "do": "clip",
   "instance": 0,
   "name": "goa_arrival_host",
   "seconds": 5,
   "fps": 10
  },
  {
   "do": "assert",
   "expr": "[runtime_log(i).count('Desync notice') for i in range(3)]==saved['notices_start']",
   "message": "A runtime logged a new desync notice by the end of the route"
  },
  {
   "do": "checkpoint",
   "name": "10 Downed: friend2 takes a lethal hit"
  },
  {
   "do": "save",
   "as": "notices_start",
   "expr": "[runtime_log(i).count('Desync notice') for i in range(3)]"
  },
  {
   "do": "protect",
   "instance": 2,
   "on": false
  },
  {
   "do": "assert",
   "expr": "location(0)[:2]==[4,26] and location(2)==location(0) and all(peek('0x7435D0','u8',i)==255 for i in (0,2))",
   "message": "The revive placement requires both players in settled GoA with menus closed"
  },
  {
   "do": "kh2ctl",
   "instance": 2,
   "argsExpr": "['poke','--addr',str(int(actor('P_EX100',2)['address'],16)+0x670),'--type','f32x3','--value','1280,0,-100']"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "do": "save",
   "as": "revive_before",
   "expr": "{'friend2':pos(index=2),'fires':log_count('[revive-prompt] hold complete',0),'returns':log_count('[downed] revive returned',2)}"
  },
  {
   "do": "assert",
   "expr": "dist(saved['revive_before']['friend2'],(1280,0,-100))<50",
   "message": "friend2 must settle on the open GoA floor before the lethal hit"
  },
  {
   "do": "kh2ctl",
   "instance": 2,
   "argsExpr": "['hit','kill','--victim',actor('P_EX100',2)['address']]"
  },
  {
   "do": "wait",
   "ms": 5000
  },
  {
   "do": "capture",
   "instance": 2,
   "name": "downed"
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "downed"
  },
  {
   "do": "clip",
   "instance": 2,
   "name": "downed_friend2",
   "seconds": 4,
   "fps": 6
  },
  {
   "do": "assert",
   "expr": "log_count('[downed] gate intercept', 2)>=1",
   "message": "friend2's lethal hit was not held as downed (no [downed] gate intercept)"
  },
  {
   "do": "kh2ctl",
   "instance": 0,
   "argsExpr": "['poke','--addr',str(int(actor('P_EX100',0)['address'],16)+0x670),'--type','f32x3','--value',f'{pos(index=2)[0]},{pos(index=2)[1]},{pos(index=2)[2]-90}']"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "do": "wait_until",
   "expr": "peek('0x2A11162','u16',0)==0 and peek('0x7435D0','u8',0)==255 and dist(pos(index=0),pos(index=2))<150",
   "timeoutMs": 2000,
   "message": "The native reaction command must release Triangle before a revive hold"
  },
  {
   "do": "save",
   "as": "revive_ready",
   "expr": "{'host':pos(index=0),'friend2':pos(index=2),'nativeRC':peek('0x2A11162','u16',0),'menu':peek('0x7435D0','u8',0),'distance':dist(pos(index=0),pos(index=2))}"
  },
  {
   "do": "capture",
   "instance": 0,
   "name": "revive_ready"
  },
  {
   "do": "press",
   "instance": 0,
   "button": "triangle",
   "ms": 1600
  },
  {
   "do": "wait_until",
   "expr": "any(a['name']=='P_EX100' and a['hp']>0 for a in actors(2)) and location(2)==location(0)",
   "timeoutMs": 10000
  },
  {
   "do": "assert",
   "expr": "log_count('[revive-prompt] hold complete',0)==saved['revive_before']['fires']+1 and log_count('[downed] revive returned',2)==saved['revive_before']['returns']+1",
   "message": "friend2 came back without the host's revive prompt"
  },
  {
   "do": "wait",
   "ms": 2500
  },
  {
   "do": "input",
   "instance": 2,
   "ly": 1,
   "ms": 900
  },
  {
   "do": "clip",
   "instance": 2,
   "name": "revived_friend2",
   "seconds": 3,
   "fps": 6
  }
 ]
}
