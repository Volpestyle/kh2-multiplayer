{
 "name": "net_seat_activation_calling_off",
 "description": "VUH-2864 control for net_seat_activation_calling.json: the same route with KH2COOP_SEAT_ACTIVATION=0 on the host. The friend alone reaches the first Dusk group's anchor and waits there; no Dusk may appear on either seat, which is the native one-point behaviour the change fixes. No warps, protect or save.",
 "playerDefaults": true,
 "protect": [],
 "steps": [
  {
   "do": "boot",
   "instance": 0,
   "slotMoves": -3,
   "initTimeoutMs": 60000,
   "env": {
    "KH2COOP_ENEMY_MIRROR_TRACE": "1",
    "KH2COOP_SEAT_ACTIVATION": "0"
   }
  },
  {
   "do": "boot",
   "instance": 1,
   "slotMoves": -3,
   "initTimeoutMs": 60000,
   "env": {
    "KH2COOP_ENEMY_MIRROR_TRACE": "1"
   }
  },
  {
   "do": "assert",
   "expr": "location(0)[:2] == [2,32] and location(1)[:2] == [2,32]",
   "message": "FM-00 must load the Station of Serenity on both seats"
  },
  {
   "do": "assert",
   "expr": "log_count('[spawnctl] seat-activation requested=0 predicates=1',0)==1 and log_count('[spawnctl] seat-activation requested=1 predicates=1',1)==1",
   "message": "the host's seat activation switch and both seats' predicate pins must be as this fixture declares"
  },
  {
   "do": "relay",
   "port": 27812,
   "args": [
    "--bind",
    "127.0.0.1"
   ]
  },
  {
   "do": "runtime",
   "instance": 0,
   "role": "player"
  },
  {
   "do": "runtime",
   "instance": 1,
   "role": "friend1"
  },
  {
   "do": "wait_until",
   "expr": "log_count('[enemysync] client arrived epoch=',1)>0",
   "timeoutMs": 60000
  },
  {
   "do": "hang_check",
   "instance": 0,
   "on": false
  },
  {
   "do": "hang_check",
   "instance": 1,
   "on": false
  },
  {
   "do": "pilot",
   "instance": 0,
   "route": "tools/rig/route_pilot/routes/twilight_thorn_serenity_door.json",
   "name": "host_to_calling",
   "seconds": 120,
   "input": "pad",
   "background": false
  },
  {
   "do": "wait_until",
   "expr": "location(0)==[2,33,0,0,1,0] and location(1)==location(0)",
   "timeoutMs": 60000
  },
  {
   "do": "wait_until",
   "expr": "log_count('control released at=02/21 evt=0 site=tt33-calling',0)>0 and log_count('control released at=02/21 evt=0 site=tt33-calling',1)>0",
   "timeoutMs": 60000,
   "pollMs": 500
  },
  {
   "do": "save",
   "as": "host_start",
   "expr": "[(round(a['position']['x']),round(a['position']['y']),round(a['position']['z'])) for a in actors(0) if int(a['address'],16)==int(peek('0x2A105D0','u64',0),16)]"
  },
  {
   "do": "save",
   "as": "deaths_before",
   "expr": "log_count('[enemysync] host death epoch',0)"
  },
  {
   "do": "assert",
   "expr": "len(enemies(0))==0 and len(enemies(1))==0",
   "message": "no Calling Dusk may exist before anyone reaches a group"
  },
  {
   "do": "clip",
   "instance": 0,
   "seconds": 30,
   "fps": 30,
   "name": "first_group_host",
   "background": true
  },
  {
   "do": "clip",
   "instance": 1,
   "seconds": 30,
   "fps": 30,
   "name": "first_group_friend",
   "background": true
  },
  {
   "do": "pilot",
   "instance": 1,
   "route": "tools/rig/route_pilot/routes/seat_activation_first_group.json",
   "name": "friend_to_first_group",
   "seconds": 60,
   "input": "pad",
   "background": false
  },
  {
   "do": "wait",
   "ms": 20000
  },
  {
   "do": "save",
   "as": "held",
   "expr": "[[(a['objectId'],a['hp']) for a in enemies(i)] for i in (0,1)]"
  },
  {
   "do": "assert",
   "expr": "len(enemies(0))==0 and len(enemies(1))==0 and log_count('[spawnctl] seat-activation side=',0)==0",
   "message": "with the switch off, a friend alone at a group starts nothing"
  },
  {
   "do": "clip_wait"
  },
  {
   "do": "save",
   "as": "host_end",
   "expr": "[(round(a['position']['x']),round(a['position']['y']),round(a['position']['z'])) for a in actors(0) if int(a['address'],16)==int(peek('0x2A105D0','u64',0),16)]"
  },
  {
   "do": "assert",
   "expr": "len(saved['host_start'])==1 and len(saved['host_end'])==1 and dist(saved['host_start'][0],saved['host_end'][0])<300",
   "message": "the host must have stayed on the platform"
  },
  {
   "do": "coop_verdict",
   "as": "verdict",
   "require": false
  }
 ]
}
