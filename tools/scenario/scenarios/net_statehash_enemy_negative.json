    },
    {
      "do": "wait_until",
      "expr": "len(enemy_hps(0)) > 0 and len(enemy_hps(1)) == len(enemy_hps(0)) and len(enemy_hps(2)) == len(enemy_hps(0))",
      "timeoutMs": 15000,
      "pollMs": 500
    },
    {
      "do": "save",
      "as": "before",
