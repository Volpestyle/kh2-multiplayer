    {
      "do": "save",
      "as": "after_damage",
      "expr": "[enemy_hps(i) for i in range(3)]"
    },
    {
      "do": "assert",
      "expr": "saved['after_damage'][0] == saved['after_damage'][1] == saved['after_damage'][2] and saved['after_damage'][0] != saved['before'][0]",
