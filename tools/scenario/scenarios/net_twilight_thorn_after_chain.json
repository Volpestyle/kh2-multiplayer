    },
    {
      "do": "assert",
      "expr": "all(row['mission'] and row['mission']['file']=='TT34_MS304.bar' and len(row['boss'])==1 and len(row['player'])==1 for row in saved['thorn_ingress'])",
      "message": "Both seats require the real Thorn mission, one exact307 boss, and a canonical native player"
    },
    {
      "do": "wait_until",
      "expr": "[(a['hp'],a['maxHp']) for a in actors(0) if a.get('objectId')==307]==[(a['hp'],a['maxHp']) for a in actors(1) if a.get('objectId')==307]",
      "timeoutMs": 10000
    },
