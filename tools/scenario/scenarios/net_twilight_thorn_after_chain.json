{
  "name": "net_twilight_thorn_after_chain",
  "description": "VUH-2921: assisted Thorn kill, both seats play the post-Thorn scenes including the Back Alley reminder and Struggle opening, then share 02/05 door50 evt2 field. Both boots retain VUH-2808 floor tracing; Cross is scoped to each seat's active Back Alley scene.",
  "testOnly": [
    "enemy_hp_write"
  ],
  "protect": [],
  "playerDefaults": true,
  "steps": [
    {
      "do": "boot",
      "instance": 0,
      "slotMoves": -3,
      "initTimeoutMs": 60000,
      "env": {
        "KH2COOP_ENEMY_MIRROR_TRACE": "1",
        "KH2COOP_THORN_HIT_TRACE": "1",
        "KH2COOP_DOWNED_SPIKE_FIXTURE": "1",
        "KH2COOP_DOWNED_SPIKE_CONTROL": "0",
        "KH2COOP_THORN_FLOOR_TRACE": "1"
      }
    },
    {
      "do": "boot",
      "instance": 1,
      "slotMoves": -3,
      "initTimeoutMs": 60000,
      "env": {
        "KH2COOP_ENEMY_MIRROR_TRACE": "1",
        "KH2COOP_THORN_HIT_TRACE": "1",
        "KH2COOP_DOWNED_SPIKE_FIXTURE": "1",
        "KH2COOP_DOWNED_SPIKE_CONTROL": "0",
        "KH2COOP_THORN_FLOOR_TRACE": "1"
      }
    },
    {
      "do": "assert",
      "expr": "(log_count('[script-rc-cache] installed refresh=408520 winner=408BD0 accept=3B22D0',0)==1 and log_count('[script-rc-cache] installed refresh=408520 winner=408BD0 accept=3B22D0',1)==1) and all(log_count('[script-lifecycle] installed motionEnd=1 captureId=1 cancel=1 queryBudget=2048 cancelBudget=1024 captureBudget=512 changedOnly=1',i)==1 and log_count('[script-lifecycle] unavailable reason=',i)==0 for i in (0,1))",
      "message": "Both seats must qualify existing RC-cache hooks, actual motion-end/capture-ID observers and sole cancel hook before any route input"
    },
    {
      "do": "assert",
      "expr": "location(0)[:2] == [2,32] and location(1)[:2] == [2,32]",
      "message": "FM-00 must load Station of Serenity on both seats; slotMoves is relative to the save-list cursor"
    },
    {
      "do": "assert",
      "expr": "(log_count('[script-rc-cache] installed refresh=408520 winner=408BD0 accept=3B22D0',0)==1 and log_count('[script-rc-cache] installed refresh=408520 winner=408BD0 accept=3B22D0',1)==1) and all(log_count('[script-lifecycle] installed motionEnd=1 captureId=1 cancel=1 queryBudget=2048 cancelBudget=1024 captureBudget=512 changedOnly=1',i)==1 and log_count('[script-lifecycle] unavailable reason=',i)==0 for i in (0,1))",
      "message": "Both seats must qualify existing RC-cache hooks, actual motion-end/capture-ID observers and sole cancel hook before any route input"
    },
    {
      "do": "relay",
      "port": 27809,
      "args": [
        "--bind",
        "127.0.0.1"
      ]
    },
    {
      "do": "runtime",
      "instance": 0,
      "role": "player"
    },
    {
      "do": "runtime",
      "instance": 1,
      "role": "friend1"
    },
    {
      "do": "wait_until",
      "expr": "log_count('[enemysync] client arrived epoch=',1)>0",
      "timeoutMs": 60000
    },
    {
      "do": "hang_check",
      "instance": 0,
      "on": false
    },
    {
      "do": "hang_check",
      "instance": 1,
      "on": false
    },
    {
      "do": "save",
      "as": "evidence_scope",
      "expr": "{'topology':'single-PC loopback, two native seats','input':'pad mailbox; no OS focus','boot':'FM-00 rehearsal, not New Game acceptance','clips':'30-second two-screen blocks; encoding gaps are not continuous footage','caption_work':'Burn in HOST / FRIEND and Single-PC loopback labels during final assembly; retain raw blocks','watchdog':'gameplay hang checks off across native event holds; all steps have fixed deadlines','reaction_observation':'Live08: existing read-only v7 promptHide from product-qualified actionable RC; raw cached RC remains diagnostic; routes/reach/timing/strategy unchanged'}"
    },
    {
      "do": "pilot",
      "instance": 0,
      "route": "tools/rig/route_pilot/routes/twilight_thorn_serenity_door.json",
      "name": "host_to_calling",
      "seconds": 120,
      "input": "pad",
      "background": false
    },
    {
      "do": "wait_until",
      "expr": "location(0)==[2,33,0,0,1,0] and location(1)==location(0)",
      "timeoutMs": 60000
    },
    {
      "do": "save",
      "as": "calling_deaths_before",
      "expr": "log_count('[enemysync] host death epoch',0)"
    },
    {
      "do": "pilot",
      "instance": 0,
      "route": "tools/rig/route_pilot/routes/twilight_thorn_calling_bots03.json",
      "name": "host_calling_path",
      "seconds": 360,
      "input": "pad",
      "background": true,
      "revivePeer": 1
    },
    {
      "do": "pilot",
      "instance": 1,
      "route": "tools/rig/route_pilot/routes/twilight_thorn_calling_bots03.json",
      "name": "friend_calling_path",
      "seconds": 360,
      "input": "pad",
      "background": true,
      "revivePeer": 0
    },
    {
      "do": "pilot_wait"
    },
    {
      "do": "assert",
      "expr": "log_count('[enemysync] host death epoch',0) >= saved['calling_deaths_before']+10 and all(not any(a.get('objectId')==318 and a.get('hp',-1)>0 for a in actors(i)) for i in (0,1))",
      "message": "The real Calling path must clear all ten Dusks on both seats before the boss door"
    },
    {
      "do": "pilot",
      "instance": 0,
      "route": "tools/rig/route_pilot/routes/twilight_thorn_menu_tutorial.json",
      "name": "host_menu_tutorial",
      "seconds": 40,
      "input": "pad",
      "background": false
    },
    {
      "do": "pilot",
      "instance": 1,
      "route": "tools/rig/route_pilot/routes/twilight_thorn_menu_tutorial.json",
      "name": "friend_menu_tutorial",
      "seconds": 40,
      "input": "pad",
      "background": false
    },
    {
      "do": "assert",
      "expr": "peek('0x7435D0','u8',0)==255 and peek('0x7435D0','u8',1)==255",
      "message": "First-open menu tutorial must be closed before boss event hold"
    },
    {
      "do": "pilot",
      "instance": 0,
      "route": "tools/rig/route_pilot/routes/twilight_thorn_awakening_bots04.json",
      "name": "host_to_awakening",
      "seconds": 260,
      "input": "pad",
      "background": false
    },
    {
      "do": "wait_until",
      "expr": "location(0)==[2,34,0,157,157,157] and location(1)==location(0) and all(any(a.get('objectId')==307 and a.get('objectType')==12 and a.get('hp',0)>0 for a in actors(i)) for i in (0,1))",
