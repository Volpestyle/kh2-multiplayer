{
  "name": "net_viewer_leaves",
  "description": "Repro for the soak crash: while instance 1's puppet of instance 0 is active and animating, instance 1 itself changes rooms, then comes back. The game must survive both transitions.",
  "steps": [
    {"do": "boot", "instance": 0},
    {"do": "boot", "instance": 1},
    {"do": "warp", "instance": 0, "world": 4, "room": 26},
    {"do": "warp", "instance": 1, "world": 4, "room": 26},
    {"do": "relay"},
    {"do": "runtime", "instance": 0, "role": "player"},
    {"do": "runtime", "instance": 1, "role": "friend1"},
    {"do": "wait_until", "expr": "(bridge(1).get('puppet0') or {}).get('active')", "timeoutMs": 10000, "pollMs": 500},
    {"do": "input", "instance": 0, "ly": 1, "ms": 900},
    {"do": "input", "instance": 0, "lx": 1, "ms": 600},
    {"do": "warp", "instance": 1, "world": 4, "room": 10},
    {"do": "wait", "ms": 3000},
    {"do": "warp", "instance": 1, "world": 4, "room": 26},
    {"do": "wait_until", "expr": "(bridge(1).get('puppet0') or {}).get('active')", "timeoutMs": 10000, "pollMs": 500},
    {"do": "input", "instance": 0, "ly": -1, "ms": 900},
    {"do": "warp", "instance": 1, "world": 4, "room": 10},
    {"do": "wait", "ms": 3000},
    {"do": "capture", "name": "after", "instance": 1}
  ]
}
