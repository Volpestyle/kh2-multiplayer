{
  "name": "net_worldmap_observe",
  "description": "VUH-2341 observation fixture: host and one friend load the default save slot with the player package's shipped defaults on an ENet loopback relay, then hold for up to 20 minutes while an operator drives the host natively to the World Map and on to a world. No warps. Hang checks are off so a paused or World Map instance is not reported as hung.",
  "playerDefaults": true,
  "protect": [
    0,
    1
  ],
  "steps": [
    {
      "do": "boot",
      "instance": 0,
      "initTimeoutMs": 60000
    },
    {
      "do": "boot",
      "instance": 1,
      "initTimeoutMs": 60000
    },
    {
      "do": "relay",
      "port": 27797,
      "args": [
        "--bind",
        "127.0.0.1"
      ]
    },
    {
      "do": "runtime",
      "instance": 0,
      "role": "player"
    },
    {
      "do": "runtime",
      "instance": 1,
      "role": "friend1"
    },
    {
      "do": "transition_check",
      "instances": [
        0,
        1
      ],
      "as": "initial",
      "capture": true
    },
    {
      "do": "hang_check",
      "instance": 0,
      "on": false
    },
    {
      "do": "hang_check",
      "instance": 1,
      "on": false
    },
    {
      "do": "wait_until",
      "expr": "exists('build/rig/worldmap-observe.stop')",
      "timeoutMs": 1200000,
      "pollMs": 2000
    }
  ]
}
